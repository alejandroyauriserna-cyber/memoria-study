# =============================================================================
# PLANTILLA (.env.example) — NO pongas aquí claves ni tu correo real.
# 1. Copia este archivo:  copy .env.example .env.local
# 2. Edita .env.local con tus valores reales (git lo ignora).
# 3. En Vercel/producción: Settings → Environment Variables (mismas claves).
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# DeepSeek gratis entra por OpenRouter (no hay API directa). Obligatorio como respaldo si Gemini se queda sin cuota.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.2
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Imágenes de infografías, mapas visuales y avatares (Flux vía Hugging Face Inference Providers)
# Token en hf.co/settings/tokens con permiso «Inference Providers» (no el API legacy).
HF_TOKEN=your_huggingface_token
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Cifrado de claves IA de usuarios (32 bytes en hex o base64). Opcional: deriva de SUPABASE_SERVICE_ROLE_KEY.
USER_AI_ENCRYPTION_KEY=
IMAGE_PROVIDER_CHAIN=flux,gemini
IMAGE_PROVIDER_CHAIN_INFOGRAPHIC=flux,gemini
IMAGE_PROVIDER_CHAIN_POSTER=flux,gemini
IMAGE_PROVIDER_CHAIN_ATLAS=flux,gemini
IMAGE_PROVIDER_CHAIN_PRESENTATION=flux,gemini
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4-fast-reasoning
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Biblioteca Jurídica (aportes y moderación) ---
# Dominios UNT permitidos para subir sentencias
JURISPRUDENCE_UNT_EMAIL_DOMAINS=unitru.edu.pe
# Moderadores: en .env.local pon TU correo real (mismo con el que inicias sesión).
# Ejemplo en .env.local: JURISPRUDENCE_MODERATOR_EMAILS=amyauris@unitru.edu.pe
JURISPRUDENCE_MODERATOR_EMAILS=
# Auto-publicar tras N aportes aprobados del mismo autor (default 3)
JURISPRUDENCE_TRUSTED_APPROVALS=3
# Email a moderadores (opcional — sin RESEND_API_KEY solo se registra en logs)
RESEND_API_KEY=
JURISPRUDENCE_NOTIFY_FROM_EMAIL=Biblioteca Jurídica <noreply@tudominio.com>

# Funciones Pro (generación de imagen en servidor). Visual IA está activo por defecto.
# NEXT_PUBLIC_PREMIUM_FEATURES=gemini-infographic,gemini-visual-map
