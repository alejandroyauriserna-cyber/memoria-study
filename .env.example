NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# DeepSeek gratis entra por OpenRouter (no hay API directa). Obligatorio como respaldo si Gemini se queda sin cuota.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.2
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
# Imágenes de infografías y mapas visuales (proveedor por defecto: Flux vía Hugging Face)
HF_TOKEN=your_huggingface_token
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Cadena global de fallback (solo proveedores registrados: flux, gemini)
IMAGE_PROVIDER_CHAIN=flux,gemini
# Cadenas por formato (opcional; si no están, usa IMAGE_PROVIDER_CHAIN)
IMAGE_PROVIDER_CHAIN_INFOGRAPHIC=flux,gemini
IMAGE_PROVIDER_CHAIN_POSTER=flux,gemini
IMAGE_PROVIDER_CHAIN_ATLAS=flux,gemini
IMAGE_PROVIDER_CHAIN_PRESENTATION=flux,gemini
# Respaldo de imagen (Nano Banana): gemini-2.5-flash-image, gemini-3.1-flash-image-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
XAI_API_KEY=your_xai_api_key
XAI_MODEL=grok-4-fast-reasoning
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Biblioteca Jurídica — aportes comunitarios (solo cuentas @unitru.edu.pe)
JURISPRUDENCE_UNT_EMAIL_DOMAINS=unitru.edu.pe
# Moderadores: TU correo (el mismo con el que inicias sesión en la app).
# Varios emails separados por coma. Tras cambiar esto, reinicia `npm run dev`.
# En local, si lo dejas vacío, cualquier usuario autenticado puede moderar (solo desarrollo).
JURISPRUDENCE_MODERATOR_EMAILS=tu-correo@unitru.edu.pe
# Auto-publicar tras N aportes aprobados del mismo autor (default 3)
JURISPRUDENCE_TRUSTED_APPROVALS=3
# Email a moderadores (opcional — sin RESEND_API_KEY solo se registra en logs)
RESEND_API_KEY=
JURISPRUDENCE_NOTIFY_FROM_EMAIL=Biblioteca Jurídica <noreply@tudominio.com>
# Funciones Pro (generación de imagen en servidor). Visual IA está activo por defecto; añade más flags separados por coma.
# NEXT_PUBLIC_PREMIUM_FEATURES=gemini-infographic,gemini-visual-map
